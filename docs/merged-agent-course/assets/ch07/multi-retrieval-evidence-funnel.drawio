        <mxCell id="title" value="从多路检索到 Evidence Pack 的证据漏斗" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;sketch=1;comic=1;curveFitting=1;jiggle=1;fontFamily=Kaiti SC;fontSize=38;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="980" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="先授权，再召回；先扩大候选覆盖，再用治理、排序和预算逐步收窄" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Kaiti SC;fontSize=18;fontColor=#526071;" vertex="1" parent="1">
          <mxGeometry x="550" y="80" width="1000" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#F7F7F5;fillOpacity=50;strokeColor=#9AA39B;strokeWidth=2;dashed=1;dashPattern=10 7;" vertex="1" parent="1"><mxGeometry x="45" y="155" width="320" height="790" as="geometry"/></mxCell>
        <mxCell id="p2" value="" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#EEF9F6;fillOpacity=50;strokeColor=#55A997;strokeWidth=2;dashed=1;dashPattern=10 7;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="375" height="790" as="geometry"/></mxCell>
        <mxCell id="p3" value="" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFF8DF;fillOpacity=50;strokeColor=#C59A3A;strokeWidth=2;dashed=1;dashPattern=10 7;" vertex="1" parent="1"><mxGeometry x="820" y="155" width="370" height="790" as="geometry"/></mxCell>
        <mxCell id="p4" value="" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#EFF6FD;fillOpacity=50;strokeColor=#79AEE0;strokeWidth=2;dashed=1;dashPattern=10 7;" vertex="1" parent="1"><mxGeometry x="1230" y="155" width="350" height="790" as="geometry"/></mxCell>
        <mxCell id="p5" value="" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#F7F7F5;fillOpacity=50;strokeColor=#9AA39B;strokeWidth=2;dashed=1;dashPattern=10 7;" vertex="1" parent="1"><mxGeometry x="1620" y="155" width="435" height="790" as="geometry"/></mxCell>

        <mxCell id="h1" value="&lt;b&gt;1 · 请求与治理边界&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;文本离开数据域之前完成硬过滤&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="75" y="170" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="h2" value="&lt;b&gt;2 · 四路并行检索&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;不同索引捕获不同类型的相关性&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="435" y="170" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="h3" value="&lt;b&gt;3 · 候选融合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;统一格式，但不抹平来源语义&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="280" height="65" as="geometry"/></mxCell>
        <mxCell id="h4" value="&lt;b&gt;4 · 多维重排与选择&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;相关性之外还要考虑权威和风险&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="1260" y="170" width="290" height="65" as="geometry"/></mxCell>
        <mxCell id="h5" value="&lt;b&gt;5 · Evidence Pack&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;模型只接收少量、可追溯的证据&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="1650" y="170" width="330" height="65" as="geometry"/></mxCell>

        <mxCell id="request" value="&lt;b style=&quot;font-size:20px&quot;&gt;Retrieval Request&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务 · 查询 · 数据域&lt;br&gt;可信身份 · 用途 · 预算&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;不是只复制用户最后一句话&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFF8DF;strokeColor=#C59A3A;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="85" y="270" width="240" height="175" as="geometry"/></mxCell>
        <mxCell id="filter" value="&lt;b style=&quot;font-size:20px&quot;&gt;Domain Hard Filter&lt;/b&gt;&lt;br&gt;&lt;br&gt;ACL · 租户 · 用途 · 有效期&lt;br&gt;撤权 · Tombstone · 隔离&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;过滤条件下推到各检索器并持续生效&lt;br&gt;硬约束不能被相关性抵消&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FAE9E6;strokeColor=#C36B6B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="85" y="515" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="reject" value="&lt;b style=&quot;font-size:20px&quot;&gt;Hard Reject&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;未授权 · 已撤权 · 租户不匹配&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;已确认或已标记的注入风险&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFF3EF;strokeColor=#C36B6B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="85" y="780" width="240" height="105" as="geometry"/></mxCell>

        <mxCell id="structured" value="&lt;b style=&quot;font-size:18px&quot;&gt;Structured&lt;/b&gt;&lt;br&gt;时间 · 状态 · 用户 · 版本&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;精确过滤与实体字段&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#F3F5F2;strokeColor=#8C978E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="455" y="260" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="sparse" value="&lt;b style=&quot;font-size:18px&quot;&gt;Sparse / BM25&lt;/b&gt;&lt;br&gt;编号 · 错误码 · 专有名词&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;精确字符串与罕见术语&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#E0EEFB;strokeColor=#5E96CA;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="455" y="400" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="dense" value="&lt;b style=&quot;font-size:18px&quot;&gt;Dense / Embedding&lt;/b&gt;&lt;br&gt;语义相似 · 同义表达 · 意图&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;允许词汇不重叠&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#DFF4EE;strokeColor=#4F9F8E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="455" y="540" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="graph" value="&lt;b style=&quot;font-size:18px&quot;&gt;Graph / Hierarchical&lt;/b&gt;&lt;br&gt;关系 · 谱系 · 层次 · 多跳&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;扩展时必须控制噪声&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#F1ECFB;strokeColor=#8B75B4;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="455" y="680" width="280" height="110" as="geometry"/></mxCell>

        <mxCell id="pool" value="&lt;b style=&quot;font-size:20px&quot;&gt;Normalized Candidate Pool&lt;/b&gt;&lt;br&gt;&lt;br&gt;domain · canonical_ref&lt;br&gt;source_ref · version · ACL&lt;br&gt;sparse · dense · freshness&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;统一格式不是统一语义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFFDF8;strokeColor=#C59A3A;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="865" y="270" width="280" height="225" as="geometry"/></mxCell>
        <mxCell id="fusion" value="&lt;b style=&quot;font-size:20px&quot;&gt;Fusion + Deduplicate&lt;/b&gt;&lt;br&gt;&lt;br&gt;RRF 或已校准的加权融合&lt;br&gt;去重 · 近重复合并 · 来源保留" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFEFBD;strokeColor=#C59A3A;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="865" y="555" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="pool-note" value="候选逐渐收窄&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#536171&quot;&gt;但仍保留数据域、来源和版本&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;不能只剩一段无出处文本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#F7F7F5;strokeColor=#9AA39B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="865" y="770" width="280" height="105" as="geometry"/></mxCell>

        <mxCell id="rerank" value="&lt;b style=&quot;font-size:20px&quot;&gt;Multi-signal Rerank&lt;/b&gt;&lt;br&gt;&lt;br&gt;语义相关性 · 词法相关性&lt;br&gt;任务相关性 · 权威性 · 置信度&lt;br&gt;作用域 · 新鲜度 · 环境相似度&lt;br&gt;冲突惩罚 · 陈旧度 · 冗余&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;不同数据域使用不同权重&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#E0EEFB;strokeColor=#5E96CA;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1270" y="275" width="270" height="250" as="geometry"/></mxCell>
        <mxCell id="selector" value="&lt;b style=&quot;font-size:20px&quot;&gt;Coverage + Budget&lt;/b&gt;&lt;br&gt;&lt;br&gt;覆盖多个子问题和关键例外&lt;br&gt;在 token 预算内选择正文与摘要&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;高分重复项不能挤掉必要证据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFF8DF;strokeColor=#C59A3A;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1270" y="600" width="270" height="180" as="geometry"/></mxCell>

        <mxCell id="pack" value="&lt;b style=&quot;font-size:20px&quot;&gt;Relevant Persistent Information&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;untrusted data, not instructions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFFDF8;strokeColor=#8C978E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="1660" y="265" width="355" height="570" as="geometry"/></mxCell>
        <mxCell id="memory-evidence" value="&lt;b style=&quot;font-size:20px&quot;&gt;Memory Evidence&lt;/b&gt;&lt;br&gt;主体 · 作用域 · 证据强度 · 冲突状态&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;memory://mem_42 · source · updated_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#DFF4EE;strokeColor=#4F9F8E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=14;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1690" y="365" width="295" height="120" as="geometry"/></mxCell>
        <mxCell id="knowledge-evidence" value="&lt;b style=&quot;font-size:20px&quot;&gt;Knowledge Evidence&lt;/b&gt;&lt;br&gt;权威版本 · 地域 · 有效期 · 原文位置&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;knowledge://chunk_19 · policy-v7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#E0EEFB;strokeColor=#5E96CA;strokeWidth=2;fontFamily=Kaiti SC;fontSize=14;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1690" y="515" width="295" height="120" as="geometry"/></mxCell>
        <mxCell id="conflict-evidence" value="&lt;b style=&quot;font-size:20px&quot;&gt;Conflict / Constraint&lt;/b&gt;&lt;br&gt;保留反例、限制条件和未解决冲突&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;不得被多数结果或高相似度覆盖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FAE9E6;strokeColor=#C36B6B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=14;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1690" y="665" width="295" height="120" as="geometry"/></mxCell>

        <mxCell id="request-filter" value="derive filters" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B6F86;strokeWidth=2.5;endArrow=block;endFill=1;fontFamily=Kaiti SC;fontSize=12;fontColor=#4B6F86;labelBackgroundColor=#FFFDF8;" edge="1" parent="1" source="request" target="filter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-reject" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B55353;strokeWidth=2.5;dashed=1;dashPattern=9 7;endArrow=block;endFill=1;fontFamily=Kaiti SC;fontSize=12;fontColor=#B55353;labelBackgroundColor=#FFFDF8;" edge="1" parent="1" source="filter" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="filter-structured" value="过滤条件下推" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#23806F;strokeWidth=2.5;endArrow=block;endFill=1;fontFamily=Kaiti SC;fontSize=12;fontColor=#23806F;labelBackgroundColor=#FFFDF8;" edge="1" parent="1" source="filter" target="structured"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="600"/><mxPoint x="385" y="315"/></Array></mxGeometry></mxCell>
        <mxCell id="filter-sparse" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#23806F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="filter" target="sparse"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="600"/><mxPoint x="385" y="455"/></Array></mxGeometry></mxCell>
        <mxCell id="filter-dense" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#23806F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="filter" target="dense"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="600"/><mxPoint x="385" y="595"/></Array></mxGeometry></mxCell>
        <mxCell id="filter-graph" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#23806F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="filter" target="graph"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="600"/><mxPoint x="385" y="735"/></Array></mxGeometry></mxCell>

        <mxCell id="structured-pool" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B6F86;strokeWidth=2.3;endArrow=block;endFill=1;" edge="1" parent="1" source="structured" target="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sparse-pool" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B6F86;strokeWidth=2.3;endArrow=block;endFill=1;" edge="1" parent="1" source="sparse" target="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dense-pool" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B6F86;strokeWidth=2.3;endArrow=block;endFill=1;" edge="1" parent="1" source="dense" target="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="graph-pool" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4B6F86;strokeWidth=2.3;endArrow=block;endFill=1;" edge="1" parent="1" source="graph" target="pool"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="pool-fusion" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9A6B12;strokeWidth=2.7;endArrow=block;endFill=1;" edge="1" parent="1" source="pool" target="fusion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fusion-rerank" value="shortlist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9A6B12;strokeWidth=2.7;endArrow=block;endFill=1;fontFamily=Kaiti SC;fontSize=12;fontColor=#9A6B12;labelBackgroundColor=#FFFDF8;" edge="1" parent="1" source="fusion" target="rerank"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="628"/><mxPoint x="1200" y="405"/></Array></mxGeometry></mxCell>
        <mxCell id="rerank-selector" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9A6B12;strokeWidth=2.7;endArrow=block;endFill=1;" edge="1" parent="1" source="rerank" target="selector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="selector-pack" value="selected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9A6B12;strokeWidth=2.7;endArrow=block;endFill=1;fontFamily=Kaiti SC;fontSize=12;fontColor=#9A6B12;labelBackgroundColor=#FFFDF8;" edge="1" parent="1" source="selector" target="pack"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="footer" value="证据漏斗的目标不是找到“最像”的文本，而是形成当前任务可安全使用的最小充分证据集" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Kaiti SC;fontSize=15;fontColor=#536171;" vertex="1" parent="1"><mxGeometry x="570" y="1010" width="960" height="35" as="geometry"/></mxCell>
