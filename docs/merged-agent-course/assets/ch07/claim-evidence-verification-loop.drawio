        <mxCell id="evidence-heading" value="&lt;b&gt;1 · Evidence Pack&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;只使用已授权、可追溯的候选证据&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;sketch=1;comic=1;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="78" y="164" width="360" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="claim-heading" value="&lt;b&gt;2 · 原子 Claim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;把回答拆成可独立验证的事实主张&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;sketch=1;comic=1;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="592" y="164" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="verify-heading" value="&lt;b&gt;3 · 支持关系验证&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;逐条判断，而不是只检查引用是否存在&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;sketch=1;comic=1;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1008" y="164" width="350" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="outcome-heading" value="&lt;b&gt;4 · 输出决策&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#647184&quot;&gt;发布、修订，或停止生成&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;sketch=1;comic=1;fontFamily=Kaiti SC;fontSize=24;fontColor=#172033;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1472" y="164" width="250" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="&lt;b style=&quot;font-size:20px&quot;&gt;E1 · 长期记忆&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#536171&quot;&gt;[memory:mem_42 · verified]&lt;/font&gt;&lt;br&gt;&lt;br&gt;上次申请因缺少订单号未提交&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;Evidence: session:s_8/event:e_93&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#DFF4EE;strokeColor=#4F9F8E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="78" y="245" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="&lt;b style=&quot;font-size:20px&quot;&gt;E2 · 外部知识&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#536171&quot;&gt;[knowledge:chunk_19 · policy-v7]&lt;/font&gt;&lt;br&gt;&lt;br&gt;签收后 7 天内可申请退款&lt;br&gt;提交时必须提供订单号&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;Source: policy/refund.md#申请条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#E0EEFB;strokeColor=#5E96CA;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="78" y="425" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="&lt;b style=&quot;font-size:20px&quot;&gt;E3 · 冲突 / 限制证据&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#536171&quot;&gt;[knowledge:chunk_27 · regional-rule]&lt;/font&gt;&lt;br&gt;&lt;br&gt;部分地区和商品不适用 7 天规则&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;不能被多数证据或更高相似度静默覆盖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FAE9E6;strokeColor=#C36B6B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="78" y="635" width="380" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;C1 · 历史事实&lt;/b&gt;&lt;br&gt;&lt;br&gt;“你的上次申请&lt;br&gt;没有提交成功”" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#F3F5F2;strokeColor=#8C978E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="595" y="250" width="287" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;C2 · 当前要求&lt;/b&gt;&lt;br&gt;&lt;br&gt;“这次申请需要&lt;br&gt;提供订单号”" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#F3F5F2;strokeColor=#8C978E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="595" y="440" width="287" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b style=&quot;font-size:20px&quot;&gt;C3 · 过度推断&lt;/b&gt;&lt;br&gt;&lt;br&gt;“你一定可以在 7 天内获得退款”&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;证据只支持申请条件，不支持结果保证&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFF3EF;strokeColor=#C36B6B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="595" y="640" width="287" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="v1" value="&lt;b style=&quot;font-size:20px&quot;&gt;C1 → E1　&lt;font color=&quot;#23806F&quot;&gt;direct&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;原始事件直接支持历史事实&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;结论范围没有超过证据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#EEF9F6;strokeColor=#55A997;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1005" y="245" width="330" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="v2" value="&lt;b style=&quot;font-size:20px&quot;&gt;C2 → E2　&lt;font color=&quot;#3478B8&quot;&gt;direct&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;当前有效政策直接陈述要求&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;版本、地域和有效期均可追溯&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#EFF6FD;strokeColor=#79AEE0;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1005" y="435" width="330" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="v3" value="&lt;b style=&quot;font-size:20px&quot;&gt;C3 → E2 + E3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9A6B12&quot;&gt;partial&lt;/font&gt;　&lt;font color=&quot;#B55353&quot;&gt;contradicted&lt;/font&gt;&lt;br&gt;&lt;br&gt;证据不足，并存在适用范围冲突&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;不能原样发布&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FAE9E6;strokeColor=#C36B6B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1005" y="590" width="330" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;关键 Claim&lt;br&gt;支持充分吗？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFE5A3;strokeColor=#B78624;strokeWidth=2;fontFamily=Kaiti SC;fontSize=20;fontColor=#172033;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1005" y="745" width="320" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="publish" value="&lt;b style=&quot;font-size:20px&quot;&gt;带引用发布&lt;/b&gt;&lt;br&gt;&lt;br&gt;只发布被支持的 Claim&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#536171&quot;&gt;C1 [E1] · C2 [E2]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#DFF4EE;strokeColor=#4F9F8E;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1465" y="245" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="revise" value="&lt;b style=&quot;font-size:20px&quot;&gt;修订与限制说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;缩小结论范围&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#536171&quot;&gt;保留冲突 · 重新验证&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FFF8DF;strokeColor=#C59A3A;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1465" y="455" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="stop" value="&lt;b style=&quot;font-size:20px&quot;&gt;停止生成&lt;/b&gt;&lt;br&gt;&lt;br&gt;继续检索 · 请求澄清&lt;br&gt;查询权威工具 · 拒答&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#647184&quot;&gt;不用流畅性掩盖证据缺口&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;comic=1;curveFitting=1;jiggle=1;fillColor=#FAE9E6;strokeColor=#C36B6B;strokeWidth=2;fontFamily=Kaiti SC;fontSize=16;fontColor=#344255;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
