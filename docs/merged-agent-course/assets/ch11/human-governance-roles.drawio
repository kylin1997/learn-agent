        <mxCell id="over-to-loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="human-over" target="agent-loop">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="210"/><mxPoint x="405" y="298"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="on-to-loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sketch=1;curveFitting=1;jiggle=2;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.833333;entryX=1;entryY=0.105263;" edge="1" parent="1" source="human-on" target="agent-loop">
